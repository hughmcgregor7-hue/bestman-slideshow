    height: 100vh;
    background: var(--bg);
  }
  .slide {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }
  .slide.active {
    opacity: 1;
  }
  .slide img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
